{
  "cleanUrls": true,
  "builds": [
    { "src": "ws.mjs", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/ws", "dest": "/ws.mjs" },
    { "handle": "filesystem" }
  ],
  "headers": [
    {
      "source": "/(.*\\.wasm)",
      "headers": [{ "key": "Content-Type", "value": "application/wasm" }]
    },
    {
      "source": "/(.*\\.pck)",
      "headers": [{ "key": "Content-Type", "value": "application/octet-stream" }]
    }
  ]
}
